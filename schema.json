{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Playgama Bridge Config (v2)",
    "type": "object",
    "additionalProperties": false,
    "patternProperties": {
        "^\\$schema$": {
            "type": "string"
        }
    },
    "properties": {
        "debug": {
            "type": "boolean",
            "default": false,
            "description": "Enable SDK debug logging"
        },
        "forciblySetPlatformId": {
            "$ref": "#/definitions/platformId"
        },
        "remoteConfigUrl": {
            "type": "string",
            "description": "URL of a remotely hosted bridge config that replaces the local one (except forciblySetPlatformId and remoteConfigUrl)"
        },
        "remoteConfigTimeout": {
            "type": "number",
            "default": 2000,
            "description": "Remote config fetch timeout in milliseconds"
        },
        "remoteConfigTtl": {
            "type": "number",
            "default": 3600000,
            "description": "Remote config cache TTL in milliseconds"
        },
        "sendAnalyticsEvents": {
            "type": "boolean",
            "default": true
        },
        "disableLoadingLogo": {
            "type": "boolean",
            "default": false
        },
        "showFullLoadingLogo": {
            "type": "boolean",
            "default": false
        },
        "showLoadingText": {
            "type": "boolean",
            "default": false
        },
        "game": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "adaptToSafeArea": {
                    "type": "boolean",
                    "default": false,
                    "description": "Adapt the game canvas to the device safe area"
                }
            }
        },
        "platforms": {
            "type": "object",
            "additionalProperties": {
                "type": "object"
            },
            "description": "Platform-specific settings. Any root config section (advertisement, crossPromo, device, ...) may also be placed inside a platform section to override it for that platform only.",
            "properties": {
                "crazy_games": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "xsollaProjectId": {
                            "type": "string"
                        },
                        "isSandbox": {
                            "type": "boolean",
                            "default": false
                        },
                        "useUserToken": {
                            "type": "boolean",
                            "default": false
                        }
                    }
                },
                "discord": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": [
                        "appId"
                    ],
                    "properties": {
                        "appId": {
                            "type": "string"
                        }
                    }
                },
                "dlightek": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": [
                        "appKey",
                        "adSenseId"
                    ],
                    "properties": {
                        "appKey": {
                            "type": "string"
                        },
                        "adSenseId": {
                            "type": "string"
                        },
                        "adChannel": {
                            "type": "string"
                        },
                        "testMode": {
                            "type": "boolean"
                        }
                    }
                },
                "facebook": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "subscribeForNotificationsOnStart": {
                            "type": "boolean",
                            "default": false
                        }
                    }
                },
                "game_distribution": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": [
                        "gameId"
                    ],
                    "properties": {
                        "gameId": {
                            "type": "string"
                        }
                    }
                },
                "gamepush": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": [
                        "projectId",
                        "publicToken"
                    ],
                    "properties": {
                        "projectId": {
                            "type": "string"
                        },
                        "publicToken": {
                            "type": "string"
                        }
                    }
                },
                "huawei": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": [
                        "appId"
                    ],
                    "properties": {
                        "appId": {
                            "type": "string"
                        }
                    }
                },
                "jio_games": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "adTestMode": {
                            "type": "boolean"
                        }
                    }
                },
                "lagged": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": [
                        "devId",
                        "publisherId"
                    ],
                    "properties": {
                        "devId": {
                            "type": "string"
                        },
                        "publisherId": {
                            "type": "string"
                        }
                    }
                },
                "microsoft_store": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": [
                        "gameId",
                        "playgamaAdsId"
                    ],
                    "properties": {
                        "gameId": {
                            "type": "string"
                        },
                        "playgamaAdsId": {
                            "type": "string"
                        }
                    }
                },
                "msn": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": [
                        "gameId"
                    ],
                    "properties": {
                        "gameId": {
                            "type": "string"
                        }
                    }
                },
                "samsung": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "admobInterstitialAdUnitId": {
                            "type": "string"
                        },
                        "admobRewardedAdUnitId": {
                            "type": "string"
                        },
                        "gameTitle": {
                            "type": "string"
                        }
                    }
                },
                "telegram": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "adsgramBlockId": {
                            "type": "string"
                        }
                    }
                },
                "tiktok": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "clientKey": {
                            "type": "string"
                        }
                    }
                },
                "xiaomi": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": [
                        "adSenseId"
                    ],
                    "properties": {
                        "adSenseId": {
                            "type": "string"
                        },
                        "testMode": {
                            "type": "boolean"
                        }
                    }
                },
                "y8": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": [
                        "gameId"
                    ],
                    "properties": {
                        "gameId": {
                            "type": "string"
                        },
                        "adsenseId": {
                            "type": "string"
                        },
                        "channelId": {
                            "type": "string"
                        }
                    }
                },
                "yandex": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "useSignedData": {
                            "type": "boolean",
                            "default": false
                        }
                    }
                }
            }
        },
        "advertisement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "interstitial": {
                    "$ref": "#/definitions/preloadableAdUnit"
                },
                "rewarded": {
                    "$ref": "#/definitions/preloadableAdUnit"
                },
                "banner": {
                    "$ref": "#/definitions/adUnit"
                },
                "advancedBanners": {
                    "type": "object",
                    "description": "Keys other than disable/placementFallback are placement names mapped to condition-driven banner configs (edit via JSON)",
                    "properties": {
                        "disable": {
                            "type": "boolean"
                        },
                        "placementFallback": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": {
                        "type": "object"
                    }
                },
                "useBuiltInErrorPopup": {
                    "type": "boolean",
                    "default": false
                },
                "useAdvertisementErrorPopup": {
                    "type": "boolean"
                },
                "builtInErrorPopupCooldown": {
                    "type": "number",
                    "default": 180,
                    "description": "Cooldown in seconds between built-in interstitial failure popups"
                },
                "minimumDelayBetweenInterstitial": {
                    "type": "number",
                    "default": 60,
                    "description": "Minimum delay in seconds between interstitial ads"
                },
                "initialInterstitialDelay": {
                    "type": "number",
                    "description": "Delay in seconds before the first interstitial ad can be shown after game start"
                }
            }
        },
        "crossPromo": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Title shown above the cross-promo games list"
                },
                "source": {
                    "type": "string",
                    "enum": ["config", "platform"],
                    "default": "config",
                    "description": "Where the games list comes from: the static games list or the platform SDK catalog"
                },
                "games": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/crossPromoGame"
                    }
                }
            }
        },
        "dailyRewards": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "rewards"
            ],
            "properties": {
                "rewards": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Ordered list of reward ids, one per day"
                },
                "cycle": {
                    "type": "boolean",
                    "default": true
                },
                "resetOnMiss": {
                    "type": "boolean",
                    "default": true
                }
            }
        },
        "tasks": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/taskGroup"
            }
        },
        "achievements": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/achievementItem"
            }
        },
        "payments": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/paymentItem"
            }
        },
        "leaderboards": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/leaderboardItem"
            }
        },
        "device": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "useBuiltInOrientationPopup": {
                    "type": "boolean",
                    "default": false
                },
                "supportedOrientations": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": ["landscape", "portrait"]
                    }
                }
            }
        },
        "saas": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "baseUrl": {
                    "type": "string",
                    "description": "Override the default Playgama SaaS API base URL"
                },
                "publicToken": {
                    "type": "string",
                    "description": "Public token for Playgama SaaS API authentication"
                },
                "leaderboards": {
                    "$ref": "#/definitions/saasFeature"
                },
                "social": {
                    "$ref": "#/definitions/saasFeature"
                }
            }
        }
    },
    "definitions": {
        "platformId": {
            "type": "string",
            "enum": [
                "crazy_games",
                "discord",
                "dlightek",
                "facebook",
                "game_distribution",
                "gamepush",
                "gamesnacks",
                "huawei",
                "jio_games",
                "lagged",
                "microsoft_store",
                "mock",
                "msn",
                "ok",
                "playdeck",
                "playgama",
                "poki",
                "portal",
                "qa_tool",
                "reddit",
                "samsung",
                "standalone",
                "telegram",
                "tiktok",
                "vk",
                "xiaomi",
                "y8",
                "yandex",
                "youtube"
            ]
        },
        "saasFeature": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "platforms": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/platformId"
                    }
                }
            }
        },
        "adUnit": {
            "type": "object",
            "additionalProperties": false,
            "description": "placementFallback should match one of placements[].id",
            "properties": {
                "disable": {
                    "type": "boolean",
                    "description": "Disable this ad unit"
                },
                "placementFallback": {
                    "type": "string"
                },
                "placements": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/adPlacement"
                    }
                }
            }
        },
        "preloadableAdUnit": {
            "type": "object",
            "additionalProperties": false,
            "description": "placementFallback should match one of placements[].id",
            "properties": {
                "disable": {
                    "type": "boolean",
                    "description": "Disable this ad unit"
                },
                "placementFallback": {
                    "type": "string"
                },
                "preloadOnStart": {
                    "type": "string",
                    "description": "Placement id to preload right after SDK initialization"
                },
                "placements": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/adPlacement"
                    }
                }
            }
        },
        "adPlacement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Placement identifier"
                },
                "crazy_games": {
                    "type": "string"
                },
                "discord": {
                    "type": "string"
                },
                "dlightek": {
                    "type": "string"
                },
                "facebook": {
                    "type": "string"
                },
                "game_distribution": {
                    "type": "string"
                },
                "gamepush": {
                    "type": "string"
                },
                "gamesnacks": {
                    "type": "string"
                },
                "huawei": {
                    "type": "string"
                },
                "jio_games": {
                    "type": "string"
                },
                "lagged": {
                    "type": "string"
                },
                "microsoft_store": {
                    "type": "string"
                },
                "mock": {
                    "type": "string"
                },
                "msn": {
                    "type": "string"
                },
                "ok": {
                    "type": "string"
                },
                "playdeck": {
                    "type": "string"
                },
                "playgama": {
                    "type": "string"
                },
                "poki": {
                    "type": "string"
                },
                "portal": {
                    "type": "string"
                },
                "qa_tool": {
                    "type": "string"
                },
                "reddit": {
                    "type": "string"
                },
                "samsung": {
                    "type": "string"
                },
                "standalone": {
                    "type": "string"
                },
                "telegram": {
                    "type": "string"
                },
                "tiktok": {
                    "type": "string"
                },
                "vk": {
                    "type": "string"
                },
                "xiaomi": {
                    "type": "string"
                },
                "y8": {
                    "type": "string"
                },
                "yandex": {
                    "type": "string"
                },
                "youtube": {
                    "type": "string"
                }
            }
        },
        "crossPromoGame": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "url"
            ],
            "properties": {
                "url": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "icon": {
                    "type": "string"
                }
            }
        },
        "taskGroup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "type",
                "items"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Stable storage key of the group"
                },
                "type": {
                    "type": "string",
                    "enum": ["daily", "weekly", "permanent"]
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/taskItem"
                    }
                }
            }
        },
        "taskItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "targets",
                "rewards"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "targets": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/taskAmountEntry"
                    }
                },
                "rewards": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/taskAmountEntry"
                    }
                }
            }
        },
        "taskAmountEntry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "amount"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "amount": {
                    "type": "number"
                }
            }
        },
        "achievementItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id"
            ],
            "description": "Game-level achievement with optional per-platform mapping data",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "The game's achievement identifier"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "y8": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "achievement",
                        "achievementkey"
                    ],
                    "properties": {
                        "achievement": {
                            "type": "string"
                        },
                        "achievementkey": {
                            "type": "string"
                        }
                    }
                },
                "lagged": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "paymentItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id"
            ],
            "description": "for some platforms you don't need to specify product id as they match the root product id",
            "properties": {
                "id": {
                    "type": "string"
                },
                "crazy_games": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                },
                "discord": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                },
                "facebook": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                },
                "huawei": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                },
                "microsoft_store": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                },
                "msn": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                },
                "playdeck": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "amount"
                    ],
                    "properties": {
                        "amount": {
                            "type": "number"
                        }
                    }
                },
                "playgama": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "amount"
                    ],
                    "properties": {
                        "amount": {
                            "type": "number"
                        }
                    }
                },
                "portal": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                },
                "qa_tool": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "amount"
                    ],
                    "properties": {
                        "amount": {
                            "type": "number"
                        }
                    }
                },
                "reddit": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                },
                "yandex": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "leaderboardItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id"
            ],
            "description": "Leaderboard configuration with game's leaderboard ID and optional platform-specific IDs",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "The game's leaderboard identifier"
                },
                "isMain": {
                    "type": "boolean",
                    "description": "Whether this is the main/default leaderboard"
                },
                "facebook": {
                    "type": "string"
                },
                "gamesnacks": {
                    "type": "string"
                },
                "jio_games": {
                    "type": "string"
                },
                "lagged": {
                    "type": "string"
                },
                "msn": {
                    "type": "string"
                },
                "qa_tool": {
                    "type": "string"
                },
                "y8": {
                    "type": "string"
                },
                "yandex": {
                    "type": "string"
                },
                "youtube": {
                    "type": "string"
                }
            }
        }
    }
}
